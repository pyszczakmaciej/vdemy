<div class="min-h-screen grid grid-cols-1 lg:grid-cols-2 bg-white">

  <div class="hidden lg:flex bg-slate-900 border-r border-slate-800 py-12 px-16 flex-col justify-between relative overflow-hidden text-slate-200">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-transparent to-transparent opacity-50"></div>

    <div class="relative z-10 font-bold text-xl tracking-tight text-white flex items-center gap-2">
      <span class="size-6 rounded-md bg-blue-600 text-white inline-flex items-center justify-center text-xs font-black tracking-tighter shrink-0">V</span>
      Vdemy
    </div>

    <div class="relative z-10 max-w-[440px] flex flex-col gap-6 my-auto">
      <h1 class="font-serif text-4xl lg:text-5xl font-normal leading-[1.15] text-white tracking-tight">
        A quiet place to learn,<br />from people who ship.
      </h1>
      <p class="text-sm lg:text-[15px] text-slate-400 leading-relaxed font-normal">
        Vdemy is a focused library of courses from working engineers, designers, and researchers.
        No streaks, no autoplay, no infinite scroll. Just well-made lessons you can finish.
      </p>
    </div>

    <div class="relative z-10 flex gap-8 text-slate-500 text-xs font-mono tracking-wider">
      <span>280+ courses</span>
      <span>62k students</span>
      <span>4.8 avg rating</span>
    </div>
  </div>

  <div class="py-12 px-6 sm:px-12 lg:px-16 flex items-center justify-center bg-slate-50/50">
    <div class="w-full max-w-[360px]">
      <div class="flex flex-col gap-8">

        <div class="flex flex-col gap-2">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">Welcome back</h2>
          <p class="text-sm text-slate-500">
            Sign in to keep going. New here?
            <%= link_to "Create an account", sign_up_path, class: "text-blue-600 font-semibold no-underline hover:underline transition-all" %>
          </p>
        </div>

        <% if alert = flash[:alert] %>
          <div class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-800 text-sm flex items-center gap-2 shadow-sm">
            <%= alert %>
          </div>
        <% end %>

        <% if notice = flash[:notice] %>
          <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-800 text-sm flex items-center gap-2 shadow-sm">
            <%= notice %>
          </div>
        <% end %>

        <%= form_with url: session_url, class: "flex flex-col gap-5" do |form| %>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Email address</label>
            <%= form.email_field :email_address,
                                 required: true,
                                 autofocus: true,
                                 autocomplete: "username",
                                 placeholder: "you@example.com",
                                 value: params[:email_address],
                                 class: "w-full py-2.5 px-3.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 outline-none shadow-sm transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-50 animate-none" %>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Password</label>
            <%= form.password_field :password,
                                    required: true,
                                    autocomplete: "current-password",
                                    placeholder: "Enter your password",
                                    maxlength: 72,
                                    class: "w-full py-2.5 px-3.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 outline-none shadow-sm transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-50 animate-none" %>
          </div>

          <div class="flex justify-between items-center text-sm">
            <label class="inline-flex items-center gap-2 cursor-pointer group select-none">
              <input type="checkbox" name="remember" id="remember"
                     class="size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500/20 cursor-pointer" checked>
              <span class="text-slate-600 group-hover:text-slate-900 transition-colors">Remember me</span>
            </label>
            <%= link_to "Forgot password?", new_password_path, class: "text-slate-500 hover:text-slate-900 no-underline transition-colors" %>
          </div>

          <%= form.submit "Sign in",
                          class: "w-full py-2.5 mt-2 bg-blue-600 hover:bg-blue-700 text-white border-0 rounded-lg text-sm font-semibold shadow-sm transition-colors cursor-pointer text-center" %>
        <% end %>

      </div>
    </div>
  </div>

</div>