<% content_for :page_title, "Overview" %>
<% content_for :page_subtitle, "Monitor your educational platform performance in real-time." %>

<div class="p-8 flex flex-col gap-8">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
      <div class="size-12 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
        <%= course_icon("library", size: 24) %>
      </div>
      <div>
        <div class="text-sm font-medium text-slate-500">Total Courses</div>
        <div class="text-2xl font-bold text-slate-900 mt-0.5"><%= @courses.count %></div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
      <div class="size-12 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <%= course_icon("users", size: 24) %>
      </div>
      <div>
        <div class="text-sm font-medium text-slate-500">Active Students</div>
        <div class="text-2xl font-bold text-slate-900 mt-0.5"><%= @students.count %></div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
      <div class="size-12 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <%= course_icon("card", size: 24) %>
      </div>
      <div>
        <div class="text-sm font-medium text-slate-500">Published</div>
        <div class="text-2xl font-bold text-slate-900 mt-0.5"><%= @courses.select(&:published?).count %></div>
      </div>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
        <h2 class="text-sm font-bold text-slate-900 tracking-tight">Recent Courses</h2>
        <%= link_to "View all", admin_courses_path, class: "text-xs font-semibold text-blue-600 hover:text-blue-700 no-underline" %>
      </div>
      <div class="divide-y divide-slate-100 flex-1">
        <% if @courses.empty? %>
          <div class="p-6 text-center text-sm text-slate-500">No courses found in the database.</div>
        <% else %>
          <% @courses.last(5).reverse.each do |course| %>
            <div class="px-5 py-3.5 flex items-center justify-between text-sm">
              <div class="min-w-0 flex-1 pr-4">
                <div class="font-medium text-slate-900 truncate"><%= course.title.presence || "Untitled" %></div>
                <div class="text-xs text-slate-500 truncate mt-0.5"><%= course.instructor&.email_address %></div>
              </div>
              <div class="shrink-0 text-right">
                <div class="font-mono font-medium text-slate-900"><%= course.display_price %></div>
                <div class="text-[10px] text-slate-400 font-mono mt-0.5"><%= course.created_at.strftime("%b %d, %H:%M") %></div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/50">
        <h2 class="text-sm font-bold text-slate-900 tracking-tight">Recent Students</h2>
      </div>
      <div class="divide-y divide-slate-100 flex-1">
        <% if @students.empty? %>
          <div class="p-6 text-center text-sm text-slate-500">No registered students found.</div>
        <% else %>
          <% @students.last(5).reverse.each do |student| %>
            <div class="px-5 py-3.5 flex items-center gap-3 text-sm">
              <div class="size-8 rounded-full bg-slate-100 text-slate-700 font-semibold text-xs inline-flex items-center justify-center shrink-0 border border-slate-200 shadow-sm">
                <%= student.email_address.to_s.first.upcase %>
              </div>
              <div class="min-w-0 flex-1">
                <div class="font-medium text-slate-900 truncate"><%= student.email_address %></div>
                <div class="text-[10px] text-slate-400 font-mono mt-0.5">Joined: <%= student.created_at.strftime("%b %d, %Y") %></div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>

</div>