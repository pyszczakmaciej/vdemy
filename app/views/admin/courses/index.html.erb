<div>
  <% content_for :page_title, "Courses" %>
  <% content_for :page_subtitle, "#{@courses.count} #{"course".pluralize(@courses.count)}" %>
  <% content_for :topbar_actions do %>
    <%= link_to new_admin_course_path,
                class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors no-underline" do %>
      <%= course_icon("plus", size: 16) %> New course
    <% end %>
  <% end %>

  <div class="py-6 px-4 sm:px-6 lg:px-8">
    <div class="border border-gray-200 rounded-lg bg-white shadow-sm overflow-hidden">

      <% if @courses.empty? %>
        <div class="py-12 px-8 text-center text-gray-500">
          <div class="text-lg font-semibold text-gray-900 mb-2">No courses yet.</div>
          <div class="text-sm mb-4">Create your first course to get started.</div>
          <%= link_to new_admin_course_path,
                      class: "inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors no-underline" do %>
            <%= course_icon("plus", size: 16) %> New course
          <% end %>
        </div>
      <% else %>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 table-fixed">
            <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Course</th>
              <th scope="col" class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-[100px]">Level</th>
              <th scope="col" class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-[100px]">Price</th>
              <th scope="col" class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-[110px]">Status</th>
              <th scope="col" class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-[100px]">Created</th>
              <th scope="col" class="relative px-5 py-3 w-[40px]"></th>
            </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <% @courses.each do |course| %>
              <tr class="relative group hover:bg-gray-50 transition-colors duration-150">

                <td class="px-5 py-4 text-sm font-medium text-gray-900 whitespace-nowrap overflow-hidden max-w-0">
                  <%= link_to edit_admin_course_path(course),
                              class: "font-medium text-gray-900 group-hover:text-blue-600 transition-colors after:absolute after:inset-0 after:z-10 block truncate no-underline" do %>
                    <%= course.title.presence || "Untitled course" %>
                  <% end %>
                  <div class="text-xs text-gray-500 truncate mt-1 relative z-20 pointer-events-none">
                    <%= Course::CATEGORY_LABELS[course.category] %> · <%= course.instructor&.email_address %>
                  </div>
                </td>

                <td class="px-5 py-4 text-sm text-right text-gray-500 whitespace-nowrap relative z-20 pointer-events-none">
                  <%= Course::LEVEL_LABELS[course.level] %>
                </td>

                <td class="px-5 py-4 text-sm font-medium text-right font-mono whitespace-nowrap relative z-20 pointer-events-none <%= course.free? ? 'text-green-600' : 'text-gray-900' %>">
                  <%= course.display_price %>
                </td>

                <td class="px-5 py-4 text-sm text-right whitespace-nowrap relative z-20 pointer-events-none">
                  <% if course.published? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Published
                      </span>
                  <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        Draft
                      </span>
                  <% end %>
                </td>

                <td class="px-5 py-4 text-xs text-right font-mono text-gray-500 whitespace-nowrap relative z-20 pointer-events-none">
                  <%= course.created_at.strftime("%b %d") %>
                </td>

                <td class="px-5 py-4 text-sm text-right text-gray-400 whitespace-nowrap group-hover:text-blue-600 transition-colors relative z-20">
                  <%= link_to "Delete", admin_course_path(course),
                              data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this course?" },
                              class: "px-4 py-2 text-sm font-medium text-red-600 bg-white border border-red-200 rounded-md shadow-sm hover:bg-red-50 transition-colors no-underline cursor-pointer" %>
                </td>

              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

      <% end %>
    </div>
  </div>
</div>