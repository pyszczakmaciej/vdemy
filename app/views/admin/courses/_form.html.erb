<div class="p-10">
  <%= form_with(model: [:admin, course], class: "space-y-6 max-w-3xl") do |f| %>

    <%# Obsługa błędów walidacji %>
    <% if course.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
        <h2 class="text-sm font-semibold mb-2">
          <%= pluralize(course.errors.count, "błąd", "błędy", "błędów") %> uniemożliwiły zapisanie kursu:
        </h2>
        <ul class="list-disc list-inside text-xs space-y-1">
          <% course.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Sekcja: Główne informacje %>
    <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm space-y-5">
      <h3 class="text-base font-semibold text-gray-900 border-b border-gray-100 pb-2">Podstawowe dane</h3>

      <div>
        <%= f.label :title, "Tytuł kursu", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :title,
                         class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 sm:text-sm",
                         placeholder: "np. Kurs Ruby on Rails 8 od podstaw" %>
      </div>

      <div>
        <%= f.label :subtitle, "Podtytuł / Krótki opis", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :subtitle,
                         class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 sm:text-sm",
                         placeholder: "np. Wszystko co musisz wiedzieć, aby zbudować swoją pierwszą aplikację SaaS" %>
      </div>
    </div>

    <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm space-y-5">
      <h3 class="text-base font-semibold text-gray-900 border-b border-gray-100 pb-2">Szczegóły i Cennik</h3>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :category, "Kategoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :category,
                       Course::CATEGORY_LABELS.invert,
                       { prompt: "Wybierz kategorię" },
                       class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 sm:text-sm bg-white" %>
        </div>

        <div>
          <%= f.label :level, "Poziom zaawansowania", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :level,
                       Course::LEVEL_LABELS.invert,
                       { prompt: "Wybierz poziom" },
                       class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 sm:text-sm bg-white" %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 items-end bg-gray-50 p-4 rounded-md border border-gray-100">
        <div>
          <%= f.label :price, "Cena (PLN)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :price,
                             step: 0.01,
                             class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 sm:text-sm bg-white shadow-sm",
                             placeholder: "0.00" %>
        </div>

        <div class="relative flex items-center h-10">
          <div class="flex h-5 items-center">
            <%= f.check_box :free, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          </div>
          <div class="ml-3 text-sm">
            <%= f.label :free, "Ten kurs jest całkowicie darmowy", class: "font-medium text-gray-700" %>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
      <div class="relative flex items-start">
        <div class="flex h-5 items-center">
          <%= f.check_box :published, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
        </div>
        <div class="ml-3 text-sm">
          <%= f.label :published, "Opublikuj kurs", class: "font-medium text-gray-700" %>
          <p class="text-gray-500 text-xs">Zaznacz, aby kurs stał heretycko widoczny i dostępny dla kursantów na platformie.</p>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-5 border-t border-gray-200">
      <%= link_to "Anuluj", admin_courses_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 transition-colors" %>
      <%= f.submit "Zapisz kurs", class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer transition-colors" %>
    </div>

  <% end %>
</div>